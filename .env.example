# ─── Karmic Node — Variáveis de Ambiente ────────────────────────────
# Copia este ficheiro para .env.local (dev) e ao mesmo tempo mete tudo
# em Settings > Environment Variables da Vercel (produção).
# NUNCA commitas o .env.local — só o .env.example (este).

# ─── Stripe (OBRIGATÓRIO) ────────────────────────────────────────────
# Copia de https://dashboard.stripe.com/apikeys
# Começa em Test mode (chaves sk_test_ / pk_test_). Só passa para Live
# quando estiveres a certo que tudo funciona.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Signing secret do webhook — copiado de:
# Dashboard > Developers > Webhooks > (o teu endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Site (OBRIGATÓRIO) ──────────────────────────────────────────────
# URL base do site — usada para success_url / cancel_url
NEXT_PUBLIC_SITE_URL=https://karmicnode.com

# ─── Resend (OPCIONAL — para emails de confirmação) ─────────────────
# https://resend.com/api-keys
# Precisas de verificar o domínio karmicnode.com em Resend > Domains
# para poderes enviar do email encomendas@karmicnode.com
RESEND_API_KEY=re_REPLACE_ME

# ─── Formspree (JÁ EM USO, para contact form) ────────────────────────
# Não precisa de variável — o código usa a URL direta.
