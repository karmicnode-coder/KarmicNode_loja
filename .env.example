# ─── Karmic Node — Variáveis de Ambiente ────────────────────────────
# Copia este ficheiro para .env.local (dev) e ao mesmo tempo mete tudo
# em Settings > Environment Variables da Vercel (produção).
# NUNCA commitas o .env.local — só o .env.example (este).
#
# Nomes alinhados 1:1 com o que o código lê (process.env.X) em api/*.js —
# verifica sempre com: grep -rhoE "process\.env\.[A-Z_0-9]+" api/

# ─── Stripe (OBRIGATÓRIO) ────────────────────────────────────────────
# Copia de https://dashboard.stripe.com/apikeys
# Começa em Test mode (chave sk_test_). Só passa a sk_live_ quando
# tiveres a certeza que tudo funciona.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Nota: esta app não usa Stripe.js/Elements no cliente (o checkout é feito
# com Stripe Checkout hospedado via api/checkout.js, que devolve `url` e o
# browser faz window.location.href = url) — não há chave publicável
# necessária no frontend.

# Signing secret do webhook — copiado de:
# Dashboard > Developers > Webhooks > (o teu endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Métodos de pagamento extra no Stripe Checkout, além de Cartão e
# Multibanco (que já saem sempre para clientes PT). Lista separada por
# vírgulas, só aceita "klarna" e "paypal" — qualquer outro valor é
# ignorado. Deixa vazio/omite para não ativar nenhum.
# Precisas de ativar estes métodos na tua conta Stripe primeiro
# (Settings > Payment methods) antes de os ligar aqui.
STRIPE_EXTRA_METHODS=klarna,paypal

# ─── Site (OBRIGATÓRIO) ──────────────────────────────────────────────
# URL base do site — usada para success_url/cancel_url (api/checkout.js),
# links nos emails (api/create-order-email.js) e o fetch interno que o
# webhook faz para api/create-order-email e api/printful-create-order.
SITE_URL=https://karmicnode.com

# ─── Resend (OPCIONAL — emails de confirmação) ───────────────────────
# https://resend.com/api-keys — precisa do domínio karmicnode.com
# verificado em Resend > Domains.
RESEND_API_KEY=re_REPLACE_ME
# Remetente usado em todos os emails enviados por api/create-order-email.js.
RESEND_FROM=Karmic Node <encomendas@karmicnode.com>

# Email de contacto/admin da loja — usado como reply-to dos emails de
# encomenda e no packing slip enviado para a Printful. Sem esta variável,
# o código usa karmicnode@gmail.com como default.
ADMIN_EMAIL=karmicnode@gmail.com

# ─── Supabase — server-side (OPCIONAL, mas recomendado) ──────────────
# NUNCA expor a service_role key ao browser.
# Usado por: api/stripe-webhook.js (persistir orders/order_items, baixar
# stock, karma), api/promo-validate.js (promo codes + gift cards),
# api/create-order-email.js (ir buscar a order), api/printful-create-order.js,
# api/checkout.js (upload do design/PNG do Studio para o Storage antes do
# pagamento). Corre o schema em supabase/schema.sql (SQL Editor > Run).
# Sem estas variáveis a loja continua a processar pagamentos Stripe
# normalmente — só ficam inertes a persistência de encomendas, stock,
# karma, gift cards e o upload de designs personalizados.
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_ME_SERVICE_ROLE_KEY

# ─── Multivendor — Printful (OPCIONAL) ───────────────────────────────
# https://www.printful.com/dashboard/store > API
PRINTFUL_API_TOKEN=REPLACE_ME_PRINTFUL_API_TOKEN
PRINTFUL_STORE_ID=REPLACE_ME_PRINTFUL_STORE_ID

# ─── AI Chatbot KIN (OPCIONAL) ────────────────────────────────────────
# api/kin-brain.js — endpoint proxy para LLMs. Ainda não está ligado a
# nenhum botão/widget no frontend desta versão da loja; define só a
# variável do provider que pensas usar quando ligares o chat.
GROQ_API_KEY=REPLACE_ME_GROQ_API_KEY
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
MISTRAL_API_KEY=REPLACE_ME_MISTRAL_API_KEY
