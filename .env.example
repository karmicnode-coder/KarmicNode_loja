# ─── Karmic Node — Variáveis de Ambiente ────────────────────────────
# Copia este ficheiro para .env.local (dev) e ao mesmo tempo mete tudo
# em Settings > Environment Variables da Vercel (produção).
# NUNCA commitas o .env.local — só o .env.example (este).

# ─── Stripe (OBRIGATÓRIO) ────────────────────────────────────────────
# Copia de https://dashboard.stripe.com/apikeys
# Começa em Test mode (chaves sk_test_ / pk_test_). Só passa para Live
# quando estiveres a certo que tudo funciona.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Signing secret do webhook — copiado de:
# Dashboard > Developers > Webhooks > (o teu endpoint) > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Site (OBRIGATÓRIO) ──────────────────────────────────────────────
# URL base do site — usada para success_url / cancel_url
NEXT_PUBLIC_SITE_URL=https://karmicnode.com

# ─── Resend (OPCIONAL — para emails de confirmação) ─────────────────
# https://resend.com/api-keys
# Precisas de verificar o domínio karmicnode.com em Resend > Domains
# para poderes enviar do email encomendas@karmicnode.com
RESEND_API_KEY=re_REPLACE_ME

# ─── Formspree (JÁ EM USO, para contact form) ────────────────────────
# Não precisa de variável — o código usa a URL direta.

# ─── Supabase (Auth, Karma Points, Wishlist na nuvem, Admin Panel,
#      Reviews, Gift Cards, AI Chatbot, PWA push, etc.) ──────────────
# Cria um projeto em https://supabase.com/dashboard (grátis).
# Depois: Project Settings > API > copia "Project URL" e "anon public".
# Corre o schema em supabase/schema.sql (SQL Editor > New query > Run).
# Sem estas variáveis a loja funciona normalmente (catálogo + Stripe),
# só ficam inertes as funcionalidades "avançadas" acima.
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY

# ─── Supabase — server-side (usado só pelo api/stripe-webhook.js) ────
# NUNCA expor a service_role key ao browser (não usar prefixo VITE_!).
# Serve para persistir encomendas em orders/order_items e decrementar
# stock, a correr sem sessão de utilizador (bypassa RLS de propósito).
# Copia de: Project Settings > API > service_role (secret).
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY

# ─── PWA Push Notifications (OPCIONAL) ───────────────────────────────
# Gerar com: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY vai para o browser (subscrição). VAPID_PRIVATE_KEY
# fica só no servidor (api/push/send.js, nunca expor ao browser).
VITE_VAPID_PUBLIC_KEY=REPLACE_ME_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=REPLACE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_ME_VAPID_PRIVATE_KEY

# Token simples para proteger api/push/send.js (enviado no header
# x-admin-secret). Escolhe qualquer string aleatória longa.
ADMIN_API_SECRET=REPLACE_ME_RANDOM_SECRET

# ─── AI Chatbot KIN (OPCIONAL) ────────────────────────────────────────
# Endpoint LLM compatível com OpenAI (ver api/chat.js).
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Multivendor — Printful (OPCIONAL) ───────────────────────────────
# https://www.printful.com/dashboard/store > API
PRINTFUL_API_KEY=REPLACE_ME_PRINTFUL_API_KEY
PRINTFUL_STORE_ID=REPLACE_ME_PRINTFUL_STORE_ID

# ─── Multivendor — BigBuy (OPCIONAL) ─────────────────────────────────
# https://www.bigbuy.eu > API
BIGBUY_API_KEY=REPLACE_ME_BIGBUY_API_KEY
